{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floorplan-studio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "floorplan-studio"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "floorplan-studio-db",
      "database_id": "local-preview-only",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "floorplan-studio-files"
    }
  ],
  "vars": {
    "FLOORPLAN_STORAGE": "cloudflare",
    "APP_ORIGIN": "http://127.0.0.1:8787"
  },
  "observability": {
    "enabled": true
  }
}
