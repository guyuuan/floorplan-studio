# 仅用于 Workers 本地预览。复制为 .dev.vars 并填写，不要提交真实值。
# APP_ORIGIN 与本地预览端口保持一致。
APP_ORIGIN="http://127.0.0.1:8787"
# 迁移原账号时填写；全新站点可不设置。
# APP_USERNAME="your-existing-login-name"
# APP_PASSWORD="replace-with-the-existing-password"
REGISTRATION_ENABLED="true"
EMAIL_FROM="Floorplan Studio <noreply@your-verified-domain.example>"
RESEND_API_KEY="replace-with-your-resend-api-key"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
