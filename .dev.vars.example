# 仅用于 Workers 本地预览。复制为 .dev.vars 并填写，不要提交真实值。
# APP_ORIGIN 与本地预览端口保持一致。
APP_ORIGIN="http://127.0.0.1:8787"
APP_USERNAME="your-login-name"
APP_PASSWORD="replace-with-a-password-at-least-12-characters"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
MCP_TOKEN="replace-with-a-separate-random-token-at-least-32-characters"
