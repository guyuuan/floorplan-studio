# 部署脚本从当前进程环境变量读取这些配置，也可使用 Node 的 --env-file。
# 域名和账户配置不硬编码到源码；网站账号、密码和会话密钥会经 stdin 写入 Workers Secrets。
APP_ORIGIN=https://your-floorplan-domain.example
# 可选：迁移原账号及旧项目时保留这两个变量。新站点可删除。
# APP_USERNAME=your-existing-login-name
# APP_PASSWORD=replace-with-the-existing-password
# APP_OWNER_EMAIL=owner@example.com
REGISTRATION_ENABLED=true
EMAIL_FROM=Floorplan Studio <noreply@your-verified-domain.example>
RESEND_API_KEY=replace-with-your-resend-api-key
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
FLOORPLAN_D1_ID=your-real-d1-database-uuid
FLOORPLAN_R2_BUCKET=floorplan-studio-files
FLOORPLAN_WORKER_NAME=floorplan-studio
